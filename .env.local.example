# Copie este arquivo para ".env.local" e preencha os valores reais.
# ".env.local" nunca deve ser commitado (ja esta no .gitignore).

# Google Places API (New) - console.cloud.google.com
GOOGLE_PLACES_KEY=

# Firebase Admin SDK - Console do Firebase > Configuracoes do projeto > Contas de servico
# > Gerar nova chave privada (baixa um JSON com estes 3 campos).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Mantenha as quebras de linha como "\n" (uma unica linha, entre aspas).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Trava de acesso (HTTP Basic). Se preenchido, o site inteiro (incl. /api)
# pede senha - qualquer usuario, essa senha. Vazio = sem trava (so local).
# Defina na Vercel pra nao deixar a URL publica aberta.
APP_PASSWORD=
