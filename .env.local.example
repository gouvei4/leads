# Copie este arquivo para ".env.local" e preencha os valores reais.
# ".env.local" nunca deve ser commitado (ja esta no .gitignore).

# Google Places API (New) - console.cloud.google.com
GOOGLE_PLACES_KEY=

# Firebase Admin SDK - Console do Firebase > Configuracoes do projeto > Contas de servico
# > Gerar nova chave privada (baixa um JSON com estes 3 campos).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Mantenha as quebras de linha como "\n" (uma unica linha, entre aspas).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Segredo para assinar os cookies de sessao (OBRIGATORIO - sem ele o app fica
# travado). Minimo 16 chars. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Protege o endpoint de limpeza automatica (Vercel Cron chama 1x/dia e apaga
# os dados de tokens que passaram dos 30 dias). Gere igual ao AUTH_SECRET.
# Na Vercel, defina a MESMA variavel em Project Settings > Environment Variables.
CRON_SECRET=
